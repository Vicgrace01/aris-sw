---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# API credentials — get NKENNE_API_KEY from developers-api.nkenne.ai
# (email abdul@nkenne.ai if you don't have one) and GROQ_API_KEY from console.groq.com
NKENNE_API_KEY=your_nkenne_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Reasoning model + output budget
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_OUTPUT_TOKENS=400

# Upstream timeouts (milliseconds)
NKENNE_TIMEOUT_MS=30000
GROQ_TIMEOUT_MS=60000

# Local file storage (relative to project root)
SESSION_DB_PATH=data/sessions.db
GROQ_CACHE_PATH=data/groq-cache.jsonl

# Rate limiting — lower in dev, 60 in production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
CORS_ORIGIN=*

# Budget guard — NKENNEAi calls blocked when balance drops below this
TOKEN_BUDGET_FLOOR=200
