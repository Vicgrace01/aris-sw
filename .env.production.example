NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# API credentials — set via Render dashboard, never commit real values
NKENNE_API_KEY=your_nkenne_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Reasoning model + output budget
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_OUTPUT_TOKENS=400

# Upstream timeouts (milliseconds)
NKENNE_TIMEOUT_MS=30000
GROQ_TIMEOUT_MS=60000

# Persistent storage paths (Docker volume mount at /app/data/persist)
SESSION_DB_PATH=/app/data/persist/sessions.db
GROQ_CACHE_PATH=/app/data/persist/groq-cache.jsonl

# Rate limiting — higher in production for judge testing
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
CORS_ORIGIN=*

# Budget guard — NKENNEAi calls blocked when balance drops below this
TOKEN_BUDGET_FLOOR=200
